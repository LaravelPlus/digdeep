parameters:
	ignoreErrors:
		-
			message: '#^Empty array passed to foreach\.$#'
			identifier: foreach.emptyArray
			count: 1
			path: src/Analyzers/QueryAnalyzer.php

		-
			message: '#^Offset ''caller'' on array\{sql\: string, caller\: string, time_ms\: float\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/Analyzers/QueryAnalyzer.php

		-
			message: '#^Offset ''columns'' on array\{columns\: array\<int, string\>\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/Analyzers/QueryAnalyzer.php

		-
			message: '#^Offset ''columns'' on array\{name\: string, indexes\: array\<int, array\{columns\: array\<int, string\>\}\>\} on left side of \?\? does not exist\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/Analyzers/QueryAnalyzer.php

		-
			message: '#^Offset ''indexes'' on array\{name\: string, indexes\: array\<int, array\{columns\: array\<int, string\>\}\>\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/Analyzers/QueryAnalyzer.php

		-
			message: '#^Offset ''pk'' on \*NEVER\* on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/Analyzers/QueryAnalyzer.php

		-
			message: '#^Offset ''time_ms'' on array\{sql\: string, caller\: string, time_ms\: float\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/Analyzers/QueryAnalyzer.php

		-
			message: '#^Offset ''function'' on array\{function\: string, line\?\: int, file\?\: string, class\?\: class\-string, type\?\: ''\-\>''\|''\:\:'', args\?\: list\<mixed\>, object\?\: object\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/DigDeepCollector.php

		-
			message: '#^Parameter \#1 \$view of function view expects view\-string\|null, string given\.$#'
			identifier: argument.type
			count: 3
			path: src/Http/Controllers/ApiController.php

		-
			message: '#^Argument of an invalid type Illuminate\\Routing\\RouteCollectionInterface supplied for foreach, only iterables are supported\.$#'
