			message: '#^Method LaravelPlus\\DigDeep\\Mcp\\Tools\\AnalyzeQueries\:\:schema\(\) should return array\<string, Illuminate\\Contracts\\JsonSchema\\JsonSchema\> but returns array\<string, Illuminate\\JsonSchema\\Types\\StringType\>\.$#'
